# .Env.
#
# This file supports the FastAPI backend for GenAI Inventory.
#
# The file provides:
# - backend helper functions or scripts.
# - shared runtime behavior for API and maintenance workflows.
#
# Key Structures Used:
# - Python modules, environment settings, and database helpers.
#
# This file ensures:
# - backend workflows remain organized by responsibility.
# - scripts can be run for local debugging and maintenance.
#
# Editors: Aniket, Dipankar, Liam, Jin, and Philip.
DB_HOST=your-rds-endpoint.rds.amazonaws.com
DB_PORT=5432
DB_NAME=inventory
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key

# CORS — comma-separated list of allowed frontend origins
# Example: https://your-app.vercel.app,https://custom-domain.com
CORS_ORIGINS=https://your-app.vercel.app

# Set to true to skip DB writes during testing
DRY_RUN=false
