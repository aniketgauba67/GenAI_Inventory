# Frontend Configuration.
#
# This file configures the Next.js and Capacitor frontend application.
#
# The file provides:
# - tooling or runtime configuration for the frontend.
# - settings consumed by build, lint, or mobile sync commands.
#
# Key Structures Used:
# - configuration objects, plugin settings, or shared declarations.
#
# This file ensures:
# - frontend tooling reads settings from one checked-in location.
# - local and deployment builds use the same defaults.
#
# Editors: Aniket, Dipankar, Liam, Jin, and Philip.
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
