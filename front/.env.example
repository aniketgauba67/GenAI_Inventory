# .Env.
#
# This file configures the Next.js and Capacitor frontend application.
#
# The file provides:
# - tooling or runtime configuration for the frontend.
# - settings consumed by build, lint, or mobile sync commands.
#
# Key Structures Used:
# - configuration objects, plugin settings, or shared declarations.
#
# This file ensures:
# - frontend tooling reads settings from one checked-in location.
# - local and deployment builds use the same defaults.
#
# Editors: Aniket, Dipankar, Liam, Jin, and Philip.
NEXTAUTH_SECRET=your_random_secret_here

# Set to your production Vercel URL (no trailing slash)
NEXTAUTH_URL=https://your-app.vercel.app

# Backend API URL (your Railway deployment)
# Used server-side (API routes, getServerSideProps)
API_URL=https://your-backend.up.railway.app

# Backend API URL exposed to the browser
NEXT_PUBLIC_API_URL=https://your-backend.up.railway.app
