# NextAuth.js — generate a strong secret with: openssl rand -base64 32
NEXTAUTH_SECRET=your_random_secret_here

# Set to your production Vercel URL (no trailing slash)
NEXTAUTH_URL=https://your-app.vercel.app

# Backend API URL (your Railway deployment)
# Used server-side (API routes, getServerSideProps)
API_URL=https://your-backend.up.railway.app

# Backend API URL exposed to the browser
NEXT_PUBLIC_API_URL=https://your-backend.up.railway.app
